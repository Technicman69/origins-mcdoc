struct LoadCondition {
	condition: #[dispatcher_key="fabric:load_condition"] string,
	...fabric:load_condition[[condition]]
}

/// A condition that always passes
dispatch fabric:load_condition["fabric:true"] to struct True {}

/// A condition that passes if `condition` does not pass.
dispatch fabric:load_condition["fabric:not"] to struct Not {
	value: LoadCondition,
}

/// A condition that passes if each of the `condition` passes.
/// If there are no conditions to check, it always passes.
dispatch fabric:load_condition["fabric:and"] to struct And {
	/// list of resource conditions.
	values: [LoadCondition],
}

/// A condition that passes if any of the `condition` passes.
/// If there are no conditions to check, it always fails.
dispatch fabric:load_condition["fabric:or"] to struct Or {
	/// list of resource conditions.
	values: [LoadCondition],
}

/// A condition that passes if each of the specified `modIds` are loaded.
/// If there are no IDs to check, it always passes.
dispatch fabric:load_condition["fabric:all_mods_loaded"] to struct AllModsLoaded {
	/// list of strings indicating mod IDs.
	values: [string],
}

/// A condition that passes if any of the specified `modIds` are loaded.
/// If there are no IDs to check, it always fails.
dispatch fabric:load_condition["fabric:any_mods_loaded"] to struct AnyModsLoaded {
	/// list of strings indicating mod IDs.
	values: [string],
}

/// A condition that passes if each of the `tags` exist. This does not check if those tags have any entries.
/// If there are no IDs to check, it always passes, including in cases where a nonexistent registry is specified.
dispatch fabric:load_condition["fabric:tags_populated"] to struct TagsPopulated {
	/// ID of the registry the tag is for.
	registry: #[dispatcher_key="util:tag"] string,
	/// list of tag IDs to check.
	tags: [util:tag[[%parent.registry]]],
}

/// A condition that passes if each of the `features` are enabled.
/// If there are no IDs to check, it always passes. If an unknown feature is specified, it always fails.
dispatch fabric:load_condition["fabric:features_enabled"] to struct FeaturesEnables {
	/// list of the feature IDs
	features: [(
		#[id] string |
		enum(string) FeatureFlags {
			#[until="1.20"] UPDATE_1_20 = "update_1_20",
			#[until="1.20"] MINECRAFT_UPDATE_1_20 = "minecraft:update_1_20",
			BUNDLE = "bundle",
			MINECRAFT_BUNDLE = "minecraft:bundle",
			VANILLA = "vanilla",
			MINECRAFT_VANILLA = "minecraft:vanilla",
			#[since="1.20.2"] TRADE_REBALANCE = "trade_rebalance",
			#[since="1.20.2"] MINECRAFT_TRADE_REBALANCE = "minecraft:trade_rebalance",
		}
	)],
}

/// A condition that passes if each of the `entries` exist. The entries may be from static or dynamic registries.
/// If there are no IDs to check, it always passes, including in cases where a nonexistent registry is specified
dispatch fabric:load_condition["fabric:registry_contains"] to struct RegistryContains {
	/// ID of the registry.
	registry: #[dispatcher_key="util:registry_ids"] string,
	/// List of IDs to check
	values: [util:registry_ids[[%parent.registry]]],
}

